{
  "enabledPlugins": {
    "code-review@claude-code-plugins": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-code-review.sh\"",
            "if": "Bash(gh pr merge*)"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-review-before-push.sh\"",
            "if": "Bash(git push*)"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/remind-worktree.sh\"",
            "if": "Bash(git worktree add*)"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-git-stash.sh\"",
            "if": "Bash(git stash*)"
          }
        ]
      }
    ]
  }
}

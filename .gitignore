node_modules/
*.mjs
!tests/**/*.mjs
.mesh-cache/
rust/target/

# CLAUDE.md and .claude/ are ignored by a global ~/.config/git/ignore rule;
# un-ignore them for this repo so team config gets tracked.
!CLAUDE.md
!.claude/
.claude/settings.local.json
# push 前の code review の記録（scripts/record-review.sh が書く）。
# HEAD の sha に紐づくローカルの作業ファイルなので共有しない
.claude/review-log/

// `__`で始まる名前はコンパイラのもの(2026-07-29に予約)。生成JSは一時変数とランタイム
// 関数をこの接頭辞で置いているので、ユーザーが宣言するとフラットなJSスコープで内部名を隠す。
//
// **予約前は2通りに壊れていた**(どちらもTS版から存在した言語レベルの穴。実測済み):
//   `__m := 100` のあと `match v { int => __m }` が100ではなくsubjectの値を返す
//   ——checkもbuildも通って**実行結果だけが誤る**、いちばん悪い壊れ方。
//   `__idx := 42` はランタイム関数を隠して `42 is not a function`。
//
// **弾いた名前をあらゆる宣言経路から使う**(docs/handoff.md「検証の進め方」2')。
// 診断は`reserved-word`を流用しているので、既存の予約語(`class`等)と同じく
// 「宣言しない → 後続の参照はundefined-name」というカスケードになる。
struct Holder {
	v: int
}

// トップレベル定数
__LIMIT := 10

// 自由関数の名前
fn __helper() int {
	return 1
}

// 引数
fn takesArg(__n: int) int {
	return 1
}

// レシーバ
fn (__h: Holder) value() int {
	return 1
}

fn main() {
	// ローカル変数
	__local := 1
	// mut つきローカル
	mut __counter := 0
	// for のヘッダ変数
	for __i := 0; __i < 1; __i++ {
		print(1)
	}
	// for range の変数
	for __k, __x := range [1, 2] {
		print(1)
	}
	// 素の `__` だけ、と3本以上
	__ := 1
	___deep := 2
	// 単一のアンダースコアは**ブランク識別子**なので従来どおり通る
	_ = 5
	print(__local, __counter)
}

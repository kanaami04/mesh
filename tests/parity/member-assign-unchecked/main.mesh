// structフィールドへの代入の値の型を検査する(milestone 68で修正。それ以前は診断ゼロだった)。
//
// TS版 `statements.ts` の assign ケースは `assignable(valueType, expected)` と
// 複合代入の `checkArithOp` を**ターゲットの種類を問わず**通す。Rust版は代入先の種類ごとに
// 別々の規則を書いていて `Expr::Member` 分岐が `infer_expr` を呼ぶだけだったため、
// **`mesh check` は黙るのに `mesh build` が落ちる**状態になっていた
// (`rust/tests/check_implies_build.rs` の `KNOWN_VIOLATIONS` に登録されていた破れ)。
//
// 期待値は**TS版オラクルを復元して実測したもの**(手順は docs/handoff.md「TS版のソースは
// git 履歴に残っている」節)。位置が**代入文の先頭**(桁2)なのに注意——ターゲットや値の
// 位置ではない。複合代入が `type-mismatch` ではなく `invalid-operation` なのは、
// TS版が「現在値 op 右辺」を計算する規則(`checkArithOp` を二項演算子と共有)だから。
struct T {
	n: int
}

fn main() {
	t := T{n: 1}
	t.n = "not an int"
	t.n += "also not"
	print(t.n)
}
